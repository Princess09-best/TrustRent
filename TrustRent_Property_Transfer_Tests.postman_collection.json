		{
			"name": "2. Property Transfer Process",
			"item": [
				{
					"name": "Initiate Property Transfer (No Document)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response has transfer ID\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.transfer_id).to.exist;",
									"    pm.environment.set('transfer_id', jsonData.transfer_id);",
									"});",
									"",
									"pm.test(\"Response indicates processing\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.equal('processing');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{original_owner_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"property_id\": \"{{transfer_property_id}}\",\n    \"new_owner_id\": \"{{new_owner_id}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/trustchain/transfer/initiate/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"trustchain",
								"transfer",
								"initiate",
								""
							]
						},
						"description": "Original owner initiates property transfer without document"
					},
					"response": []
				},
				{
					"name": "Get Transfer Status (Original Owner)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has transfer details\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.transfer_id).to.equal(pm.environment.get('transfer_id'));",
									"    pm.expect(jsonData.property).to.exist;",
									"    pm.expect(jsonData.current_owner).to.exist;",
									"    pm.expect(jsonData.new_owner).to.exist;",
									"});",
									"",
									"// Store status to check if auto-executed",
									"var jsonData = pm.response.json();",
									"pm.environment.set('transfer_status', jsonData.status);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{original_owner_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/trustchain/transfer/{{transfer_id}}/status/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"trustchain",
								"transfer",
								"{{transfer_id}}",
								"status",
								""
							]
						},
						"description": "Original owner checks transfer status"
					},
					"response": []
				},
				{
					"name": "Get Transfer Status (New Owner)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has transfer details\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.transfer_id).to.equal(pm.environment.get('transfer_id'));",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{new_owner_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/trustchain/transfer/{{transfer_id}}/status/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"trustchain",
								"transfer",
								"{{transfer_id}}",
								"status",
								""
							]
						},
						"description": "New owner checks transfer status"
					},
					"response": []
				},
				{
					"name": "Confirm Transfer (If Not Auto-Executed)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Skip if already verified",
									"if (pm.environment.get('transfer_status') === 'verified') {",
									"    pm.request.to.skip();",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has success message\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include('successful');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{new_owner_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": {
							"raw": "{{base_url}}/api/trustchain/transfer/{{transfer_id}}/confirm/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"trustchain",
								"transfer",
								"{{transfer_id}}",
								"confirm",
								""
							]
						},
						"description": "New owner confirms property transfer (if not auto-executed)"
					},
					"response": []
				},
				{
					"name": "Check Database Status",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Ownership has been transferred\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.current_owner).to.exist;",
									"    pm.expect(jsonData.current_owner.id).to.equal(parseInt(pm.environment.get('new_owner_id')));",
									"    pm.expect(jsonData.previous_owner).to.exist;",
									"    pm.expect(jsonData.previous_owner.id).to.equal(parseInt(pm.environment.get('original_owner_id')));",
									"    pm.expect(jsonData.blockchain_status).to.equal('consistent');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{new_owner_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/trustchain/transfer/property/{{transfer_property_id}}/db-status/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"trustchain",
								"transfer",
								"property",
								"{{transfer_property_id}}",
								"db-status",
								""
							]
						},
						"description": "Check database status after transfer"
					},
					"response": []
				},
				{
					"name": "View Property After Transfer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Property has new owner\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.owner.id).to.equal(parseInt(pm.environment.get('new_owner_id')));",
									"    pm.expect(jsonData.owner.firstname).to.equal('New');",
									"    pm.expect(jsonData.owner.lastname).to.equal('Owner');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{new_owner_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/property/{{transfer_property_id}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"property",
								"{{transfer_property_id}}",
								""
							]
						},
						"description": "View property details after transfer"
					},
					"response": []
				}
			],
			"description": "Test property transfer process"
