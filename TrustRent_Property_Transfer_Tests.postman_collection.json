							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 400\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"pm.test(\"Response has error message\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.error).to.exist;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{original_owner_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"property_id\": \"{{transfer_property_id}}\",\n    \"new_owner_id\": \"99999\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/trustchain/transfer/initiate/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"trustchain",
								"transfer",
								"initiate",
								""
							]
						},
						"description": "Attempt transfer with invalid new owner ID"
					},
					"response": []
				},
				{
					"name": "Transfer Property with Wrong Owner",
					"event": [
						{
							"listen": "test",
							"script": {
