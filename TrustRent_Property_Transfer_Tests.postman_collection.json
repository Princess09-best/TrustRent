							"mode": "raw",
							"raw": "{\n    \"firstname\": \"Original\",\n    \"lastname\": \"Owner\",\n    \"email\": \"{{original_owner_email}}\",\n    \"phone_number\": \"+233555111222\",\n    \"password\": \"TestPass123!\",\n    \"role\": \"property_owner\",\n    \"id_type\": \"Ghana Card\",\n    \"id_value\": \"GHA-111222333-0\"\n}"
