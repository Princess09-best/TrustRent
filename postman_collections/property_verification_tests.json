                {
                    "name": "Verify Property (Admin)",
                   
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "// Verify required variables exist",
                                    "if (!pm.environment.get('user_property_id')) {",
                                    "    throw new Error('user_property_id environment variable is not set. Please run the Create Property test first.');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "// Extract only the message from the response",
                                    "const jsonData = pm.response.json();",
                                    "const message = { message: jsonData.message };",
                                    "",
                                    "// Set the response to only show the message",
                                    "pm.response.json = function() {",
                                    "    return message;",
                                    "};",
                                    "",
                                    "pm.test(\"Response has success message\", function () {",
                                    "    pm.expect(message.message).to.equal('Property ownership verification approved successfully.');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{admin_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"user_property_id\": {{user_property_id}},\n    \"verification_status\": \"approved\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/property/verify/",
                            "host": ["{{base_url}}"],
                            "path": ["api", "property", "verify", ""]
                        },
                        "description": "Test successful property verification by admin"
                    }
                },
