# Copy this file to .env and fill in your own values.
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. This file is the template:
# it lists which variables are needed, with no real values in it.

# ---- Django ----
# Generate a fresh one — do not reuse a key from anywhere else:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Also signs JWTs (SIMPLE_JWT.SIGNING_KEY), so leaking it lets anyone mint
# valid tokens for any user.
DJANGO_SECRET_KEY=

# True for local development. Must be False in production.
DJANGO_DEBUG=True

# Comma-separated. Required once DEBUG is False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL ----
# The three databases are created separately — see README.md.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

POSTGRES_CORE_DB=trustrent_core_db
POSTGRES_OPS_DB=trustrent_ops_db
POSTGRES_LEDGER_DB=trustrent_ledger_db
